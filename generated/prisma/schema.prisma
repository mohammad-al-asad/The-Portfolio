// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type ProjectLink {
  type  String // live | github | appstore | playstore | other
  label String?
  url   String
}

type ProjectImage {
  url    String
  path   String? // EdgeStore path; empty for images hosted elsewhere
  width  Int?
  height Int?
}

model projects {
  id                  String         @id @default(uuid()) @map("_id")
  title               String
  description         String
  detailedDescription String?
  categoryId          String? // legacy single category, superseded by categoryIds
  categoryIds         String[]
  tags                String[]
  technologies        String[]
  features            String[]
  imageUrl            String // primary image (also listed in images)
  imagePath           String
  images              ProjectImage[]
  links               ProjectLink[]
  liveUrl             String? // legacy, superseded by links
  githubUrl           String? // legacy, superseded by links
  completionDate      String?
  teamSize            String?
  featured            Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model categories {
  id          String @id @default(uuid()) @map("_id")
  name        String
  description String
}

model resumes {
  id        String @id @default(uuid()) @map("_id")
  resumeUrl String
}

model admins {
  id       String @id @default(uuid()) @map("_id")
  name     String
  email    String
  password String
}

model educations {
  id                  String   @id @default(uuid()) @map("_id")
  institution         String
  degree              String
  period              String
  location            String
  description         String
  detailedDescription String?
  gpa                 String
  courses             String[]
  imageUrl            String
  imagePath           String
  featured            Boolean? // shown on the landing page; null on older records
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model achievements {
  id                  String   @id @default(uuid()) @map("_id")
  title               String
  organization        String
  year                String
  description         String
  detailedDescription String?
  imageUrl            String
  imagePath           String
  technologies        String[]
  featured            Boolean? // shown on the landing page; null on older records
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  subject   String
  message   String
  read      Boolean? // null on messages received before read tracking
  createdAt DateTime @default(now())
}
